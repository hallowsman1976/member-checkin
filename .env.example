# Frontend (public, safe in the browser). For `npm run dev` copy to .env.development.local
# (production builds read .env.production, so a local URL can never leak into a deploy).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets: set in Supabase Edge Function secrets, NEVER prefix with VITE_.
# SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secret (production): restrict admin-staff CORS to the web app domain.
#   npx supabase secrets set ALLOWED_ORIGINS=https://<your-web-domain>
