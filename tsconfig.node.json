{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {}
  },
  "include": [
    "vite.config.ts",
    "vitest.integration.config.ts",
    "vitest.load.config.ts",
    "supabase/tests/integration",
    "supabase/tests/load"
  ]
}
